# Server only. Never use a NEXT_PUBLIC_ prefix or commit your actual key.
# Set this in .env.local and restart with Node >=24.22.1 (.nvmrc).
# The Compute integration uses the official OpenAI-compatible HTTP API.
# Starting a benchmark sends inference requests; no automatic retries/fallback.
# No attestation checks or blockchain publication are enabled by this key.
NEAR_AI_API_KEY=

# Server-side Compute selection. Omit to preserve NEAR AI Cloud behavior.
VEYRA_COMPUTE_PROVIDER=near-ai-cloud
# For Groq, set VEYRA_COMPUTE_PROVIDER=groq and use a Free-plan organization.
GROQ_API_KEY=
# Set true only after checking the key's organization is on Groq's Free plan.
# This is an operator confirmation, not an API-verified billing guarantee.
GROQ_FREE_TIER_CONFIRMED=false

# Phase D: separate Testnet publication configuration. CLI loads .env.proof.local.
# No publication is triggered by benchmark completion or page loading.
VEYRA_PROOF_NETWORK=testnet
VEYRA_PROOF_PUBLICATION_ENABLED=false
NEAR_TESTNET_PUBLISHER=
NEAR_TESTNET_PRIVATE_KEY=
# Default: private-key (retains strict existing private-key validation).
# Local macOS proof CLI only: use keychain with the existing FullAccess public key.
# Native executable path, not the npm run-near.js wrapper. Reviewed CLI: 0.31.1.
NEAR_TESTNET_SIGNER=private-key
NEAR_TESTNET_PUBLIC_KEY=
NEAR_TESTNET_CLI_PATH=
NEAR_TESTNET_RPC_URL=https://test.rpc.fastnear.com
NEAR_TESTNET_VERIFY_RPC_URL=https://archival-rpc.testnet.near.org
VEYRA_PROOF_STATE_DIR=.veyra-proof-state
# Only needed for localhost HTTP proof routes. Use 32 random bytes as 64 hex chars.
# CLI publication uses local OS authorization and an explicit commitment approval.
VEYRA_PROOF_API_TOKEN=
